; ions.mdp — for genion preprocessing
integrator       = steep
nsteps           = 0

cutoff-scheme    = Verlet
nstlist          = 20
rlist            = 1.2
coulombtype      = PME
rcoulomb         = 1.2
pme_order        = 4
fourierspacing   = 0.16
vdwtype          = Cut-off
rvdw             = 1.2
DispCorr         = no
pbc              = xyz
