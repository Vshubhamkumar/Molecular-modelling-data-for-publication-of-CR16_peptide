; em.mdp — energy minimization
integrator       = steep
emtol            = 1000.0      ; converge when Fmax < 1000 kJ/mol/nm
emstep           = 0.01        ; initial step size (nm)
nsteps           = 50000       ; max iterations

cutoff-scheme    = Verlet
nstlist          = 20
rlist            = 1.2
coulombtype      = PME
rcoulomb         = 1.2
pme_order        = 4
fourierspacing   = 0.16
vdwtype          = Cut-off
vdw-modifier     = Force-switch
rvdw-switch      = 1.0
rvdw             = 1.2
DispCorr         = no
pbc              = xyz

; No constraints during EM (allow full relaxation)
constraints      = none
